  "author": "Mayday Loader",
  "license": "AGPL-3.0-only",
  "version": "1.0.0",
  "entry": "plugin.dll",
  "api": { "major": 1, "minMinor": 0, "maxMinor": 0 },
  "games": ["mayday"],
  "builds": ["mayday-*"],
  "loadPhase": "game-ready",
  "services": [
    { "id": "anomaly.ui", "minVersion": 1 },
    { "id": "anomaly.localization", "minVersion": 1 },
    { "id": "anomaly.core", "minVersion": 1 },
    { "id": "anomaly.config", "minVersion": 1 },
    { "id": "anomaly.json", "minVersion": 1 },
    { "id": "anomaly.scheduler", "minVersion": 1 },
    { "id": "mayday.voice", "minVersion": 1 }
